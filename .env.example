# 服务端变量。不要在此文件填真实密钥。
AI_API_KEY=
AI_PROVIDER=qwen
AI_MODEL=qwen-vl-plus
FAMILY_ACCESS_VERIFIED=false
# 从可信 Sites 登录头获取实际用户 ID，不能使用浏览器自报身份。
PARENT_USER_IDS=
STUDENT_USER_IDS=

# 独立家庭登录部署（不改变现有 Sites 登录）
PUBLIC_ORIGIN=
FAMILY_SETUP_TOKEN=
JUDY_DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
# 仅本机测试时允许，生产环境保持关闭。
ALLOW_INSECURE_LOCALHOST=0
